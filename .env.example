# Copy to .env. Not in git.
# The address the server is reached at, over HTTPS.
GKG_ORIGIN=https://gkg.example.com

# python -c "import secrets; print(secrets.token_hex(32))"
# The server refuses to start with the placeholder or anything shorter than 32 characters.
GKG_SESSION_SECRET=replace-me

# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep a copy somewhere safe (a password manager): without it the stored Keep token cannot be read.
GKG_DATA_KEY=replace-me

# How often the server syncs with Keep on its own, in seconds (at least 30).
GKG_SYNC_SECONDS=120

# Where port 8791 is published: 127.0.0.1 (default) for a proxy on this machine,
# 0.0.0.0 for one elsewhere. Never leave 8791 open to the internet.
# GKG_BIND=127.0.0.1

# Time zone for the dates on the web pages.
# TZ=Europe/Berlin
